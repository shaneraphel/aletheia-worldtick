{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cds-contact-bind bind tape",
  "type": "object",
  "required": [
    "contact_id",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "contact_id": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    }
  }
}
